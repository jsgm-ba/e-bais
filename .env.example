# Copiar a .env.local para desarrollo. En Vercel, cargar como variables del proyecto. Nunca subir claves al repo.
NEXT_PUBLIC_SITE_URL=https://e-bais.vercel.app
# Vista previa: muestra borradores con su etiqueta. En Vercel Preview se activa solo con VERCEL_ENV=preview.
NEXT_PUBLIC_PREVIEW=
# Supabase (Postgres + Auth por enlace mágico)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa para formularios sin Supabase: Apps Script que escribe en una hoja
NEXT_PUBLIC_FORM_ENDPOINT=
# CKOP · Sheets Maestro (cuenta de servicio con permiso de lectura sobre la hoja)
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_MAESTRO_ID=
SHEETS_PESTANAS=SEMÁFORO 2026-2,OPORTUNIDADES
# Vercel Cron: protege /api/ckop/sync
CRON_SECRET=
# IA (tutor EVA y agentes). Apagado si está vacío.
ANTHROPIC_API_KEY=
